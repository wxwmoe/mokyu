# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm AS web
ARG WEB_UI=true
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm if [ "$WEB_UI" = true ]; then npm ci; fi
COPY web ./
RUN if [ "$WEB_UI" = true ]; then npm run build; else mkdir -p dist; fi

FROM alpine:3.23 AS image-codecs
RUN apk add --no-cache build-base ca-certificates cmake git ninja nasm pkgconf \
    brotli-dev libpng-dev libjpeg-turbo-dev lcms2-dev libheif-dev libwebp-dev vips-dev
WORKDIR /build/image
COPY src/processing/image/native/dependencies.sh ./
RUN sh dependencies.sh
FROM image-codecs AS image-tools
RUN apk add --no-cache libjxl-dev libavif-dev
COPY src/processing/image/native/hdr.sh ./
RUN sh hdr.sh
COPY src/processing/image/native/build.sh src/processing/image/native/image.c src/processing/image/native/source.h src/processing/image/native/encode.h src/processing/image/native/hdr.h src/processing/image/native/io.h src/processing/image/native/jpeg.cc ./
RUN sh build.sh

FROM rust:1.96.0-alpine3.23 AS build
ARG WEB_UI=true
RUN apk add --no-cache build-base cmake protobuf-dev
WORKDIR /build
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY --from=web /web/dist ./web/dist
RUN --mount=type=cache,id=mokyu-alpine-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=mokyu-alpine-target,target=/build/target \
    if [ "$WEB_UI" = true ]; then cargo build --release --locked --bin mokyu; \
    else cargo build --release --locked --no-default-features --bin mokyu; fi \
    && cp target/release/mokyu /mokyu

FROM alpine:3.23 AS image-runtime
RUN apk add --no-cache vips vips-heif vips-jxl libavif
COPY --from=image-tools /opt/mokyu /opt/mokyu

FROM image-runtime
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /mokyu /usr/local/bin/mokyu
RUN mkdir -p /data /config \
    && chown -R 10001:10001 /data
USER 10001:10001
EXPOSE 9000 9001 9002
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD mokyu cli status >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/mokyu"]
